# ~/.zshrc-linux

# --- Linux-specific Environment Variables ---
export GOPATH="$HOME/go/bin/:/usr/local/go/bin"
#export JAVA_HOME="/opt/amazon-corretto-11.0.26.4.1-linux-x64"
#export JAVA="$JAVA_HOME/bin"
export LOCAL_BIN="/home/niclas/.local/bin" 

export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(which javac)")")")"
export PATH="$JAVA_HOME/bin:$PATH"

# Flatpak
export FLATPAK="/var/lib/flatpak/exports/bin:$HOME/.local/share/flatpak/exports/bin"

# Append Linux-specific paths to PATH
export PATH="${JAVA}:${GOPATH}:${LOCAL_BIN}:${FLATPAK}:$PATH"

# --- Linux-specific Autosuggestions ---
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Sway
swaymsg() {
  if [ -z "$SWAYSOCK" ] && [ -n "$XDG_RUNTIME_DIR" ] && pgrep -x sway >/dev/null; then
    export SWAYSOCK="$XDG_RUNTIME_DIR/sway-ipc.$(id -u).$(pgrep -xo sway).sock"
  fi
  command swaymsg "$@"
}

# Lazy-load conda only on first use
__load_conda() {
    unfunction conda 2>/dev/null
    source /home/niclas/miniconda3/etc/profile.d/conda.sh
}

conda() {
    __load_conda
    conda "$@"
}

# use WPS to connect to wifi
wps() {
    iface="${1:-wlp0s20f3}"
    echo "Press the WPS button on the router now..."
    sleep 3
    sudo wpa_cli -i "$iface" wps_pbc
    echo
    echo "Waiting for connection..."
    watch -n 1 "nmcli device status; echo; wpa_cli -i '$iface' status 2>/dev/null | grep -E 'wpa_state|ssid|ip_address'"
}

# --- SSH keys from Bitwarden (Settings -> "Enable SSH agent") ---
# Flatpak socket first, then a native install; otherwise keep the existing agent.
for sock in "$HOME/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock" \
            "$HOME/.bitwarden-ssh-agent.sock"; do
    if [ -S "$sock" ]; then
        export SSH_AUTH_SOCK="$sock"
        break
    fi
done
unset sock
